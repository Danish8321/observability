<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted like the mechanism package (ADR-0012). The KYC estate
         includes .NET Framework services and the policy layer must reach them. -->
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RootNamespace>Raksawi.Observability.Kyc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The analyzer runs over the policy pack too. A pack that declares the
         vocabulary is not exempt from it. -->
    <ProjectReference Include="..\Raksawi.Observability.Analyzers\Raksawi.Observability.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Policy depends on mechanism, never the reverse (ADR-0001). The
         dependency became load-bearing with ADR-0017's allowlist declarations:
         DataClass and AllowedAttributeKeyAttribute are estate vocabulary and
         live in the mechanism layer, so a policy pack cannot declare its own
         Class 2 keys without referencing it. -->
    <ProjectReference Include="..\Raksawi.Observability\Raksawi.Observability.csproj" />
  </ItemGroup>

  <!-- System.Diagnostics.DiagnosticSource is no longer referenced here. Activity
       is in the BCL on .NET 10 and a package on .NET Framework, and the
       mechanism project reference above now supplies it on both targets. -->

</Project>
